# CLD: 2026-11-01T19:00:00+02:00: NetFlow9 with Docker Compose: copy to .env next to compose.yaml (cp docker/env.example .env; chmod 600 .env) and fill in.
# The passwords go into connection strings: letters and digits only (e.g. openssl rand -hex 24)

# the optional services: browser (the AI steps' web browser), mail (Haraka: inbound mail on port 25), e.g. COMPOSE_PROFILES=browser,mail
COMPOSE_PROFILES=
# with the browser profile: its address for the app (mcp.json)
#NFN_BROWSER_URL=http://playwright:8931/mcp
# with the mail profile: Haraka's host for the app, and the inbound addresses' domain (its MX record points to this host)
#HARAKA_HOST=haraka
#MAIL_INBOUND_DOMAIN=mail.example.com

# MongoDB (the mongo container): root (also nfn_admin), the app's user nfn_app, Haraka's nfn_haraka; set before the first start (the users are made then)
MONGO_ROOT_PW=
NFN_APP_PW=
NFN_HARAKA_PW=
MONGO_DB=netflow9-db

# the site: the published port (80; behind a reverse proxy, e.g. HTTP_BIND=127.0.0.1 HTTP_PORT=8080), the server name (_: any)
HTTP_BIND=0.0.0.0
HTTP_PORT=80
NGINX_SERVER_NAME=_
# compose.tls.yaml: HTTPS here, the certificate in SSL_DIR (ssl.crt, ssl.key)
#HTTPS_PORT=443
#SSL_DIR=./ssl

# the setup's defaults (/setup): the public address, the SMTP server
BASE_URL=
SMTP_HOST=
SMTP_PORT=

# the daemon's port, inside the containers' network (not published)
DAEMON_PORT=9000

# the image's user (the volumes' owner); development (compose.dev.yaml): your own (id -u, id -g)
NFN_UID=1000
NFN_GID=1000
TZ=UTC
