# Rail22 with Docker Compose: copy to docker/.env, next to compose.yaml (cd docker; cp env.example .env; chmod 600 .env) and fill in.
# The passwords go into connection strings: letters and digits only (e.g. openssl rand -hex 24)

# the optional services, both by default: browser (the AI steps' web browser), mail (Haraka: inbound mail on port 25); without one, remove it here and empty its settings below
COMPOSE_PROFILES=browser,mail
# with the browser profile: its address for the app (mcp.json)
NFN_BROWSER_URL=http://playwright:8931/mcp
# with the mail profile: Haraka's host for the app, and the inbound addresses' domain (required: its MX record points to this host)
HARAKA_HOST=haraka
MAIL_INBOUND_DOMAIN=
# Haraka's published port (25; development: 2525 on 127.0.0.1)
MAIL_PORT=25

# MongoDB (the mongo container): root (also nfn_admin), the app's user nfn_app, Haraka's nfn_haraka; set before the first start (the users are made then)
MONGO_ROOT_PW=
NFN_APP_PW=
NFN_HARAKA_PW=
MONGO_DB=rail22-db

# the site: the published port (80; behind a reverse proxy, e.g. HTTP_BIND=127.0.0.1 HTTP_PORT=8080), the server name (_: any)
HTTP_BIND=0.0.0.0
HTTP_PORT=80
NGINX_SERVER_NAME=_
# compose.tls.yaml: HTTPS here, the certificate in SSL_DIR (ssl.crt, ssl.key)
#HTTPS_PORT=443
#SSL_DIR=../ssl

# the setup's defaults (/setup): the public address, the SMTP server
BASE_URL=
SMTP_HOST=
SMTP_PORT=

# the daemon's port, inside the containers' network (not published)
DAEMON_PORT=9000

# the containers', volumes' and images' prefix (docker.sh setup: rail22-<the folder's name>), one per installation on a host
COMPOSE_PROJECT_NAME=rail22

# the image's user (the volumes' owner); development (compose.dev.yaml): your own (id -u, id -g)
NFN_UID=1000
NFN_GID=1000
# the data's folder (an absolute path): config, logs, var, tmp, assets, bounces, mongo-data, haraka-queue, haraka-dkim in it
# (docker.sh setup: <the user's home>/docker-volumes, the folders made with their owners)
DATA_DIR=
TZ=UTC
