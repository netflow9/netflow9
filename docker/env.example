# Rail22 with Docker Compose: copy to docker/.env, next to compose.yaml (cd docker; cp env.example .env; chmod 600 .env) and fill in.
# The passwords go into connection strings: letters and digits only (e.g. openssl rand -hex 24)

# the optional service, on by default: browser (the AI steps' web browser); without it, remove it here and empty NFN_BROWSER_URL
COMPOSE_PROFILES=browser
# with the browser profile: its address for the app (mcp.json)
NFN_BROWSER_URL=http://playwright:8931/mcp

# the host's Haraka (the operator's: README.md, Inbound mail), with compose.mail.yaml in COMPOSE_FILE: Haraka for the app (host.docker.internal, empty: none),
# the database's and the daemon's ports published on the host's 127.0.0.1 for it (nfn.ini: uri, job_port)
HARAKA_HOST=
#MONGO_HOST_PORT=27017
#DAEMON_HOST_PORT=9000

# MongoDB (the mongo container): root (also nfn_admin), the app's user nfn_app, Haraka's nfn_haraka; set before the first start (the users are made then)
MONGO_ROOT_PW=
NFN_APP_PW=
NFN_HARAKA_PW=
MONGO_DB=rail22-db

# the site, for the operator's reverse proxy (HTTPS there: README.md): published on 127.0.0.1:8080; the server name (_: any)
HTTP_BIND=127.0.0.1
HTTP_PORT=8080
NGINX_SERVER_NAME=_

# the setup's defaults (/setup): the public address (the proxy's, https://...), the SMTP server (the host's Haraka: host.docker.internal, 25)
BASE_URL=
SMTP_HOST=
SMTP_PORT=

# the daemon's port, inside the containers' network (not published)
DAEMON_PORT=9000

# the containers', volumes' and images' prefix (docker.sh setup: rail22-<the folder's name>), one per installation on a host
COMPOSE_PROJECT_NAME=rail22

# the image's user (the volumes' owner); development (compose.dev.yaml): your own (id -u, id -g)
NFN_UID=1000
NFN_GID=1000
# the data's folder (an absolute path): config, logs, var, tmp, assets, bounces (the host's Haraka writes them: its bounce_dir), mongo-data in it
# (docker.sh setup: <the user's home>/docker-volumes, the folders made with their owners)
DATA_DIR=
TZ=UTC
