# the site on plain HTTP (port 80, published on 127.0.0.1:8080): behind the operator's reverse proxy (the host's nginx, Caddy, ...: README.md), which holds the
# certificate and sets X-Forwarded-For / X-Forwarded-Proto. Trusted from the private ranges only (Docker's networks: the host's proxy arrives from the bridge's gateway)

# HTTPS for PHP (session cookies' secure flag, the setup's check) when the proxy received HTTPS
map $http_x_forwarded_proto $nfn_https {
    default "";
    https on;
}

server {
    server_name ${NGINX_SERVER_NAME};
    listen 80 default_server;
    listen [::]:80 default_server;

    # the client's address for PHP (REMOTE_ADDR): the last one of X-Forwarded-For not in these ranges
    set_real_ip_from 10.0.0.0/8;
    set_real_ip_from 172.16.0.0/12;
    set_real_ip_from 192.168.0.0/16;
    set_real_ip_from fc00::/7;
    real_ip_header X-Forwarded-For;
    real_ip_recursive on;

    include /etc/nginx/nfn/locations.conf;
}
