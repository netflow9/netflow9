# repo root is $HOME - ignore everything by default, then whitelist the project files
/*
/.*

# --- tracked ---
!/.gitignore
!/app/
!/public_html/
!/scripts/
!/app.env.example
!/install.sh
!/README.md
!/LICENSE
# Docker Compose: all its files in docker/
!/docker/

# --- never commit (secrets / runtime) ---
app.env
# the compose settings (passwords), next to docker/compose.yaml
/docker/.env
# an installation's own settings (plugins.json, mcp.json, next to app.env, are not whitelisted above)
*.local.php
# plugins kept in their own repositories, cloned into app/plugins/ (each its own git repository): MultiTenant (toolmk/multitenant), RegionalRO (toolmk/regional-ro), SAP (toolmk/sap)
/app/plugins/MultiTenant/
/app/plugins/RegionalRO/
/app/plugins/SAP/
*.key
*.pem
/haraka/
*.log
*.tgz
compliance/
frontend/
etc/
tests/
