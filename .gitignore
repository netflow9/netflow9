# repo root is $HOME - ignore everything by default, then whitelist the project files
/*
/.*

# --- tracked ---
!/.gitignore
!/app/
!/public_html/
!/scripts/
!/app.env.example
!/install.sh
!/README.md
!/LICENSE

# --- never commit (secrets / runtime) ---
public_html/assets/
app.env
# an installation's own settings (plugins.json, mcp.json, next to app.env, are not whitelisted above)
*.local.php
# plugins kept in their own repositories, cloned into app/plugins/ (each its own git repository): MultiTenant (netflow9/multitenant)
/app/plugins/MultiTenant/
*.key
*.pem
/haraka/
*.log
*.tgz
compliance/
frontend/
etc/
tests/
