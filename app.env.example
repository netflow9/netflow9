#!/bin/bash

BASE=

BASE_URL=

#mongo database
#mongodb://<username>:<password>@db1.example.net:27017,db2.example.net:2500/?replicaSet=
#see: https://docs.mongodb.com/manual/reference/connection-string/#connections-connection-options
MONGO_URI=
MONGO_DB=

#outbound SMTP
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=
#false, 'ssl', or 'tls'
SMTP_SECURE=
SMTP_AUTOTLS=

SMTP_DOMAIN=
# CLD: 2026-10-31T12:12:05+02:00: the sender address of the app's emails (default noreply@<SMTP_DOMAIN>, else noreply@localhost); written by the setup when given
MAIL_FROM=
# CLD: 2026-10-31T12:12:05+02:00: the name the app greets the SMTP server with (EHLO / HELO; default the server's host name)
SMTP_FROM_DOMAIN=


#where to report errors
ERRORS_EMAIL=

#CLD: 2026-10-05T20:06:50+03:00: application secret used by \sys\Security encrypt/decrypt
APP_SECRET=

#integrations
# CLD: 2026-10-31T12:12:05+02:00: not read yet: reserved for a commercial setup (the installation's own Microsoft / Google apps); the credentials carry their own client ID and secret
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# CLD: 2026-10-15T11:37:04+03:00: the domain of the inbound email addresses (Email inbound trigger; Haraka receives it: haraka/config/host_list)
MAIL_INBOUND_DOMAIN=
# CLD: 2026-10-31T12:12:05+02:00: where Haraka is installed (default <app>/haraka, as scripts/2_haraka-install.sh installs it)
HARAKA_DIR=

# CLD: 2026-10-31T18:30:00+02:00: the port of this installation's web browser for the AI steps (scripts/playwright-mcp.sh: nfn-playwright-<user>, on 127.0.0.1); default 8931.
# Several installations on one server: a port each (e.g. live 8931, development 8932)
PLAYWRIGHT_MCP_PORT=

# CLD: 2026-10-30T15:00:00+02:00: MAX_SYNC_EXECUTIONS removed: every execution runs in the daemon (its own limits: daemon::run --max-per-account / --max-per-project)

# CLD: 2026-10-23T15:00:00+03:00: the HTTP Request and Download File steps may call this machine and its network (localhost, 10.x, 192.168.x, 169.254.x, ...): true / false
# (default false: public addresses only, for each redirect too)
HTTP_STEPS_ALLOW_PRIVATE=false

# CLD: 2026-10-23T23:20:00+03:00: development mode (app.debug): error details on the pages, development-only endpoints (DataController): true / false
# (default false when missing; never true on a public server)
APP_DEBUG=false

# CLD: 2026-10-23T23:30:00+03:00: the least severe messages written to logs/app.log: ERROR, WARN, INFO or DEBUG (default INFO when missing or not one of them)
LOG_LEVEL=INFO


# CLD: 2026-10-31T12:12:05+02:00: the System AI (SystemAI plugin): the model server this installation offers to every account, as the Assistant's provider System and in the AI steps of
# the same provider (Credential: System AI); off (no AI credits menu) when SYSTEM_AI_PROVIDER or SYSTEM_AI_MODEL is empty.
# SYSTEM_AI_PROVIDER: anthropic, openai, gemini, ollama or lemonade; SYSTEM_AI_URL: empty = the provider's own API (Gemini: its OpenAI-compatible URL, as the Assistant uses it)
# the prices (USD per 1M tokens) are needed for models other than Claude's
# Paid in credits: the credits of every account per month (no rollover; top-ups: ./v SystemAI::credits::add), the most one request (an Assistant request, an AI step's run)
# may reserve (0 = no limit). Credits per model and the margin: app/plugins/SystemAI/credit_rates.php
SYSTEM_AI_PROVIDER=
SYSTEM_AI_URL=
SYSTEM_AI_API_KEY=
SYSTEM_AI_MODEL=
SYSTEM_AI_EFFORT=high
SYSTEM_AI_PRICE_INPUT=
SYSTEM_AI_PRICE_OUTPUT=
SYSTEM_AI_MONTHLY_CREDITS=500
SYSTEM_AI_MAX_CREDITS_PER_REQUEST=200
