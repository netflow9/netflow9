#!/bin/bash

BASE=

BASE_URL=

#mongo database
#mongodb://<username>:<password>@db1.example.net:27017,db2.example.net:2500/?replicaSet=
#see: https://docs.mongodb.com/manual/reference/connection-string/#connections-connection-options
MONGO_URI=
MONGO_DB=

#outbound SMTP
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=
#false, 'ssl', or 'tls'
SMTP_SECURE=
SMTP_AUTOTLS=

SMTP_DOMAIN=


#where to report errors
ERRORS_EMAIL=

#CLD: 2026-10-05T20:06:50+03:00: application secret used by \sys\Security encrypt/decrypt
APP_SECRET=

#integrations
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# CLD: 2026-10-15T11:37:04+03:00: the domain of the inbound email addresses (Email inbound trigger; Haraka receives it: haraka/config/host_list)
MAIL_INBOUND_DOMAIN=

# CLD: 2026-10-17T19:29:50+03:00: executions run inside a web request (designer Run, Webhook, Form, Human task, MCP run_workflow) at the same time, per account; 0 =
# Over the limit: a run that must answer with its result (Webhook "when finished", MCP) is refused (429), the others are handed to the daemon
MAX_SYNC_EXECUTIONS=


# CLD: 2026-10-22T14:00:00+03:00: the Assistant's System provider (Assistant plugin): offered to every account as "System"; off when ASSISTANT_PROVIDER or ASSISTANT_MODEL is empty.
# CLD: 2026-10-23T10:00:00+03:00: the System AI (SystemAI plugin; were ASSISTANT_*, still read when a SYSTEM_AI_ one is empty): the Assistant's provider System and the AI steps of
# the same provider (Credential: System AI); off when SYSTEM_AI_PROVIDER or SYSTEM_AI_MODEL is empty.
# SYSTEM_AI_PROVIDER: anthropic, openai, gemini, ollama or lemonade; SYSTEM_AI_URL: empty = the provider's own API (Gemini: its OpenAI-compatible URL, as the Assistant uses it)
# the prices (USD per 1M tokens) are needed for models other than Claude's
# Paid in credits: the credits of every account per month (no rollover; top-ups: ./v SystemAI::credits::add), the most one request (an Assistant request, an AI step's run)
# may reserve (0 = no limit). Credits per model and the margin: app/plugins/SystemAI/credit_rates.php
SYSTEM_AI_PROVIDER=
SYSTEM_AI_URL=
SYSTEM_AI_API_KEY=
SYSTEM_AI_MODEL=
SYSTEM_AI_EFFORT=high
SYSTEM_AI_PRICE_INPUT=
SYSTEM_AI_PRICE_OUTPUT=
SYSTEM_AI_MONTHLY_CREDITS=500
SYSTEM_AI_MAX_CREDITS_PER_REQUEST=200
